* {
    font-family: "Segoe UI", "Microsoft YaHei", Arial;
    color: #20231f;
}

QMainWindow, QWidget#centralWidget {
    background: #f1efe6;
}

QToolBar {
    background: #141a17;
    border: none;
    border-bottom: 1px solid #28322d;
    spacing: 8px;
    padding: 9px 14px;
}

QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 7px 9px;
    font-size: 12px;
    color: #f2f5ed;
}

QToolButton:hover {
    background: #25342e;
    border-color: #4f6359;
}

QToolButton:pressed {
    background: #0f766e;
}

QFrame#heroPanel {
    background: #fbfaf5;
    border: 1px solid #cfd8ca;
    border-radius: 6px;
}

QLabel#eyebrowLabel {
    color: #0f766e;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
}

QLabel#heroTitle {
    color: #151914;
    font-size: 26px;
    font-weight: 800;
}

QLabel#heroSubtitle {
    color: #626b5f;
    font-size: 13px;
}

QLabel#statusCard, QLabel#metricCard, QLabel#metricCardWide {
    background: #ffffff;
    border: 1px solid #dce1d7;
    border-radius: 6px;
    padding: 10px 12px;
    font-size: 12px;
}

QLabel#statusCard {
    border-left: 4px solid #0f766e;
}

QLabel#metricCardWide {
    border-left: 4px solid #d89b24;
}

QGroupBox {
    background: #fbfaf5;
    border: 1px solid #d8ddd2;
    border-radius: 6px;
    margin-top: 12px;
    padding: 14px 10px 10px 10px;
    font-size: 13px;
    font-weight: 700;
    color: #273026;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 7px;
    background: #fbfaf5;
}

QTableWidget, QTableView {
    background: #fffefa;
    alternate-background-color: #f5f7f0;
    border: 1px solid #d8ddd2;
    border-radius: 6px;
    gridline-color: #e2e5dc;
    selection-background-color: #dbece6;
    selection-color: #17211a;
    font-size: 13px;
}

QTableWidget::item {
    padding: 6px;
}

QHeaderView::section {
    background: #eef2e8;
    color: #273026;
    border: none;
    border-right: 1px solid #d8ddd2;
    border-bottom: 1px solid #d8ddd2;
    padding: 7px;
    font-size: 12px;
    font-weight: 700;
}

QTableWidget::item:selected {
    background: #cfe7df;
    color: #111713;
}

QPushButton {
    background: #20342d;
    color: #ffffff;
    border: 1px solid #20342d;
    border-radius: 6px;
    padding: 7px 13px;
    font-size: 12px;
    font-weight: 700;
}

QPushButton:hover {
    background: #0f766e;
    border-color: #0f766e;
}

QPushButton:pressed {
    background: #0b5f59;
}

QComboBox {
    background: #ffffff;
    border: 1px solid #d8ddd2;
    border-radius: 6px;
    padding: 6px 28px 6px 10px;
    font-size: 12px;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QDockWidget {
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
    font-size: 13px;
    font-weight: 700;
}

QDockWidget::title {
    background: #141a17;
    color: #ffffff;
    padding: 9px 10px;
    text-align: left;
}

QTextEdit#insightText {
    background: #fbfaf5;
    border: 1px solid #d8ddd2;
    padding: 14px;
    font-size: 13px;
}

QCustomPlot {
    background: #fffefa;
    border: 1px solid #d8ddd2;
    border-radius: 6px;
}

QStatusBar {
    background: #fcfbf6;
    border-top: 1px solid #d8ddd2;
    font-size: 12px;
    color: #626b5f;
}

QLabel#StatusLabel {
    color: #455044;
    padding-left: 8px;
}
