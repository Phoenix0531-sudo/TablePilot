* {
    font-family: "SF Pro Text", "Segoe UI", "Microsoft YaHei", Arial;
    color: #1d1d1f;
}

QMainWindow, QWidget#centralWidget {
    background: #f5f5f7;
}

QToolBar {
    background: rgba(255, 255, 255, 235);
    border: none;
    border-bottom: 1px solid #e5e5ea;
    spacing: 6px;
    padding: 10px 16px;
}

QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 14px;
    padding: 7px 13px;
    font-size: 13px;
    font-weight: 500;
    color: #1d1d1f;
}

QToolButton:hover {
    background: #ffffff;
    border-color: #d1d1d6;
}

QToolButton:pressed {
    background: #e8f2ff;
    border-color: #9dccff;
    color: #0066cc;
}

QFrame#heroPanel {
    background: #ffffff;
    border: 1px solid #e5e5ea;
    border-radius: 18px;
}

QLabel#eyebrowLabel {
    color: #0066cc;
    font-size: 11px;
    font-weight: 650;
}

QLabel#heroTitle {
    color: #1d1d1f;
    font-size: 30px;
    font-weight: 700;
}

QLabel#heroSubtitle {
    color: #6e6e73;
    font-size: 13px;
}

QLabel#statusCard, QLabel#metricCard, QLabel#metricCardWide {
    background: #fbfbfd;
    border: 1px solid #e5e5ea;
    border-radius: 16px;
    padding: 11px 13px;
    font-size: 12px;
}

QLabel#statusCard {
    border-left: 3px solid #34c759;
}

QLabel#metricCardWide {
    border-left: 3px solid #ff9f0a;
}

QGroupBox {
    background: #ffffff;
    border: 1px solid #e5e5ea;
    border-radius: 18px;
    margin-top: 14px;
    padding: 16px 12px 12px 12px;
    font-size: 13px;
    font-weight: 650;
    color: #1d1d1f;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 14px;
    padding: 0 8px;
    background: #ffffff;
}

QTableWidget, QTableView {
    background: #ffffff;
    alternate-background-color: #fafafa;
    border: 1px solid #e5e5ea;
    border-radius: 14px;
    gridline-color: #eeeeef;
    selection-background-color: #e8f2ff;
    selection-color: #1d1d1f;
    font-size: 13px;
}

QTableWidget::item {
    padding: 7px;
}

QTableWidget::item:selected {
    background: #dcedff;
    color: #1d1d1f;
}

QHeaderView::section {
    background: #f5f5f7;
    color: #3a3a3c;
    border: none;
    border-right: 1px solid #e5e5ea;
    border-bottom: 1px solid #e5e5ea;
    padding: 8px;
    font-size: 12px;
    font-weight: 650;
}

QPushButton {
    background: #007aff;
    color: #ffffff;
    border: 1px solid #007aff;
    border-radius: 14px;
    padding: 7px 15px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton:hover {
    background: #0066cc;
    border-color: #0066cc;
}

QPushButton:pressed {
    background: #0052a3;
}

QComboBox {
    background: #ffffff;
    border: 1px solid #d1d1d6;
    border-radius: 12px;
    padding: 6px 28px 6px 11px;
    font-size: 13px;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QDockWidget {
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
    font-size: 13px;
    font-weight: 650;
}

QDockWidget::title {
    background: #ffffff;
    color: #1d1d1f;
    border-bottom: 1px solid #e5e5ea;
    padding: 10px 12px;
    text-align: left;
}

QTextEdit#insightText {
    background: #ffffff;
    border: 1px solid #e5e5ea;
    border-radius: 16px;
    padding: 15px;
    font-size: 13px;
}

QCustomPlot {
    background: #ffffff;
    border: 1px solid #e5e5ea;
    border-radius: 16px;
}

QStatusBar {
    background: #ffffff;
    border-top: 1px solid #e5e5ea;
    font-size: 12px;
    color: #6e6e73;
}

QLabel#StatusLabel {
    color: #6e6e73;
    padding-left: 8px;
}
